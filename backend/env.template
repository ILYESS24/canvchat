# 🔑 Configuration locale - Copie ce fichier en ".env" et configure ta clé API

# OpenRouter API Key - OBLIGATOIRE
# Obtiens ta clé sur : https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REMPLACE_PAR_TA_NOUVELLE_CLE

# Environment
ENV_MODE=local

# Backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/v1

# Port
PORT=8000

# Optional: OpenRouter Site Configuration
OR_SITE_URL=https://kortik.com
OR_APP_NAME=Kortix AI

# ⚠️ INSTRUCTIONS :
# 1. Copie ce fichier : cp env.template .env
# 2. Édite .env et remplace OPENROUTER_API_KEY par ta vraie clé
# 3. Ajoute des crédits sur : https://openrouter.ai/credits
# 4. Redémarre le backend : python api.py
